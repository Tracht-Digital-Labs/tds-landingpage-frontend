---
import Arrow from "~/components/ui/Arrow.astro";
import "~/styles/contact.css";
import { imageHints } from "~/lib/imageCatalog";
import { tFor, resolveLang } from "~/lib/i18n";
import { cmsFor } from "~/lib/cms";
// Only the HREF here since 2026-09-29. The QR code went with the mini card
// (see the note at the aside): it encoded the destination this link already
// has. The firewall it used to illustrate still stands and still matters on the
// card pages themselves — the QR travels as a PATH, never as the encoder,
// because `lib/businessCardQr.ts` imports `qrcode` at module scope, the package
// is a devDependency and is not in the release tree, and reaching for it from a
// page answered 500 on the host. `businessCardQr.test.ts` keeps that.
import { businessCardHref } from "~/lib/businessCard";
import { getHomeContent } from "~/lib/homeContent";
import ContactForm from "~/components/islands/ContactForm.tsx";
import { headingText } from "~/lib/heading";
import PlaceBubble from "~/components/ui/PlaceBubble.astro";
import PhoneIcon from "~/components/ui/PhoneIcon.astro";
import { socialLinks, whatsappHref } from "~/lib/socials";
import { siteConfig } from "~/lib/seo";
import type { ServiceId } from "~/lib/services";

const lang = resolveLang(Astro.currentLocale);
const t = tFor(Astro.currentLocale);

// Editable contact heading + info (email/phone/location). Field *labels*
// stay in tds-shared (t.contact.info.*Label, t.contact.form.*). Shared with
// the Footer's contact block at build time (cms.ts memoises the fetch).
//
// Die ÜBERSCHRIFT kommt aus `lib/homeContent.ts`, nicht mehr aus tds-shared:
// sie ist Startseiten-Copy und wird von genau diesem `<h2>` gelesen. Der
// Footer ruft denselben CMS-Block auf, nimmt daraus aber nur E-Mail, Telefon
// und Ort — die beiden Aufrufe dürfen also verschiedene Defaults übergeben,
// weil `cmsFor` pro Aufruf mergt und nur den FETCH memoisiert.
const heading = getHomeContent(lang).contactHeading;
const contact = await cmsFor("contact", lang, {
  label: t.contact.label,
  headline: heading.headline,
  headlineAccent: heading.headlineAccent,
  sub: heading.sub,
  email: t.contact.info.email,
  phone: t.contact.info.phone,
  location: t.contact.info.location,
  /**
   * The options in the form's reason dropdown, editable in the panel under
   * `contact.reasons`.
   *
   * Committed non-empty, and that is load-bearing rather than tidy:
   * `mergeCmsValue` refuses an override for a list whose committed fallback is
   * empty, because an empty default gives it no runtime shape to validate the
   * incoming items against. Ship `[]` here and every edit Julian makes in the
   * panel is discarded in silence, for good.
   *
   * The entries lead with the panel the site is written for (since
   * 2026-10-06), then the takeover, and end with a way out, so nobody has to
   * misfile their request to send it.
   */
  reasons:
    lang === "de"
      ? [
          "Kundenportal oder Verwaltungspanel",
          "Bestehende Website übernehmen",
          "Onlineshop übernehmen oder reparieren",
          "Fehler auf einer laufenden Seite",
          "Pflege und Wartung",
          "Abläufe digitalisieren",
          "Etwas anderes",
        ]
      : [
          "Customer portal or admin panel",
          "Take over an existing website",
          "Take over or repair an online shop",
          "A fault on a live site",
          "Maintenance and upkeep",
          "Digitalize workflows",
          "Something else",
        ],
});

/**
 * Which reason the service assistant's recommendation preselects.
 *
 * It lives HERE, beside the list it picks from, because that is the only place
 * that can keep the two in step — `lib/serviceFinder.ts` has never seen these
 * strings, and they share no wording with the service names ("Webauftritt"
 * against "Bestehende Website übernehmen"), so a text match between them would
 * never fire.
 *
 * Not every service has one, and the gaps are deliberate rather than
 * unfinished: the assistant recommends "Beratung & Konzeption" precisely when
 * nothing else pointed anywhere, and filing that under a concrete reason would
 * be inventing the answer the visitor did not give. An unmapped service leaves
 * the dropdown as it was.
 *
 * The index, not the text: an edit to the wording above moves with it, and an
 * editor who replaces the whole list in the panel simply gets no preselection
 * instead of a wrong one (the form checks the value is actually an option).
 */
const reasonForService: Partial<Record<ServiceId, number>> = {
  panels: 0,
  "web-presence": 1,
  process: 5,
  solutions: 5,
};
const assistantReasons = Object.fromEntries(
  Object.entries(reasonForService)
    .map(([id, index]) => [id, contact.reasons[index as number]])
    .filter(([, reason]) => typeof reason === "string"),
) as Record<string, string>;

// What happens after sending. It used to stand ABOVE the form, where it was a
// wall between the visitor and the field they came here to type in — and it
// repeated the process section word for word. It is the confirmation's content
// now: the same four points, at the moment they answer the only open question.
const nextSteps = await cmsFor("first_call", lang, getHomeContent(lang).firstCall);

// Phone display reads with country code spaced for legibility; the
// tel: href version strips the spaces so dialers handle it cleanly.
const phoneDisplay = contact.phone;
const phoneHref = phoneDisplay.replace(/\s/g, "");
// The business landline (2026-11-03), code-owned; the CMS number above is the mobile.
const landlineHref = siteConfig.telephone.replace(/\s/g, "");

/**
 * Profiles only. WhatsApp is a way to reach a person and has its own row in the
 * card above the seam; `lib/socials.ts` already treats it as a messenger deep
 * link rather than a profile (it is absent from the JSON-LD `sameAs` for the
 * same reason). Listing it in both places would be one label for two identical
 * links a centimetre apart.
 */

/**
 * The WhatsApp glyph, taken from the shared icon set rather than copied: the row
 * in the card needs it at a different size than `SocialLinks` renders, and two
 * copies of a brand path is how one of them ends up a version behind.
 */
const WHATSAPP_ICON =
  socialLinks(contact.phone).find((link) => link.id === "whatsapp")?.icon ?? "";

// Card chrome, localized here rather than in the CMS block: these are labels
// for links, not copy an editor should be able to empty.
const ui =
  lang === "de"
    ? {
        reachTitle: "Direkt erreichbar",
        landlineLabel: "Telefon",
        channelsLabel: "Messenger und Profile",
        region: "bei Hamburg · Kreis Herzogtum Lauenburg",
        businessCard: "Visitenkarte",
        saveContact: "Kontakt speichern",
        urgentBadge: "Auch für Notfälle",
      }
    : {
        reachTitle: "Direct contact",
        landlineLabel: "Phone",
        channelsLabel: "Messenger and profiles",
        region: "near Hamburg · District of Herzogtum Lauenburg",
        businessCard: "Business card",
        saveContact: "Save contact",
        urgentBadge: "Emergencies too",
      };
---

{/* Vollflächiges TDS-Navy. Weiterhin KEIN Wash und keine Formen —
    "keine konkurrierenden Farbverläufe hinter dem Formular" gilt
    unverändert; ein zweiter Farbverlauf hinter Eingabefeldern ist genau
    das, was hier nie passieren darf. Was dazugekommen ist, ist etwas
    anderes: ein stark gedämpfter Fotogrund unter unverändertem Navy.
    Er bringt keine zweite Farbe ein, sondern nur Textur, und der Scrim
    darüber ist dieselbe Navy-Fläche — die Ecke mit dem Formular bleibt
    deckend.

    `relative` ist hier Voraussetzung, nicht Kosmetik: `.tds-tone-navy`
    setzt nur Farbe, keine `position`, und ohne einen positionierten
    Vorfahr würde die `.tds-decor` darunter auf den nächsten
    positionierten Vorfahren aufspannen statt auf diesen Abschnitt.

    Das `.tds-tone-navy` primitive re-mapped außerdem die Seiten-Tokens
    innerhalb des Blocks (ink / muted / line / card), so any shared
    primitive rendered in here — a `.field`, a hairline — reads on the
    dark ground without the call site overriding it. */}
<section
  id="contact"
  class="section-spacing tds-tone-navy relative"
  aria-labelledby="contact-heading"
>
  <span class="tds-decor" aria-hidden="true">
    {/* Objekte unten rechts, warmes Abendlicht, der Rest fällt in den
        Schatten — die leere Hälfte liegt also dort, wo Überschrift und
        Formular stehen. `object-right-bottom`, damit dieser Aufbau den
        Zuschnitt überlebt: der Abschnitt ist hoch, `object-cover`
        beschneidet hier waagerecht. */}
    <img
      src="/images/sections/contact-editorial.webp"
      srcset={imageHints("/images/sections/contact-editorial.webp", "de")?.srcSet}
      sizes="100vw"
      width="1860" height="840"
      alt={lang === "de" ? "Dunkler Schreibtisch mit Telefon und Notizbuch im Licht einer Lampe" : "Dark desk with a telephone and a notebook in lamplight"}
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="contact-photo absolute inset-0 h-full w-full object-cover object-right-bottom"
      data-motion-image
    />
    <span class="contact-photo-scrim absolute inset-0"></span>
  </span>
  <div class="lp-container">
    <h2
      id="contact-heading"
      class="display text-4xl md:text-5xl lg:text-6xl text-white mb-4 text-center md:text-left"
    >
      {headingText(contact.headline, contact.headlineAccent)}
    </h2>
    {/* The three-part brand accent on its lifted (on-dark) run — the
        bordeaux segment sinks into the navy at its light value. */}
    <span
      aria-hidden="true"
      class="tds-brandbar tds-brandbar--on-dark mx-auto md:mx-0 mb-8"
    ></span>

    {/* The "what happens next" card that used to stand here is gone. It said
        the same four things as the process section, verbatim, one screen
        further down — and it pushed the form itself below the fold. The form's
        confirmation carries it now, which is where it is actually an answer. */}

    {/* ONE card (2026-10-12): the form and the ways to reach a person, side
        by side from `lg` and parted by a vertical seam (a horizontal one when
        stacked). Solid lifted navy with the hard coral offset, the card
        language of the page. The form sits in a WRAPPER rather than a class
        inside the island: the island has two roots, the form and the success
        view, and both belong on the same surface. Form 3 parts, contacts 2. */}
    <div class="contact-panel">
      <div class="contact-panel__form">
        <ContactForm
          client:visible
          lang={lang}
          reasons={contact.reasons}
          assistantReasons={assistantReasons}
          nextSteps={{ title: nextSteps.nextStepsTitle, items: nextSteps.items }}
        />
      </div>

      {/* Top to bottom (2026-10-12): e-mail and phone as full rows, one under
          the other; WhatsApp and the profiles side by side; the business card
          and the .vcf; the town with its map bubble last.

          WhatsApp appears ONCE, as a messenger, not again among the profile
          icons. `lib/socials.ts` makes the same distinction: it is a deep
          link, not a profile, which is why it is absent from `sameAs`. */}
      <aside class="contact-card" aria-labelledby="contact-card-title">
        <p id="contact-card-title" class="eyebrow contact-card__title">{ui.reachTitle}</p>

        <ul class="contact-ways">
          <li>
            <a class="contact-way" href={`mailto:${contact.email}`}>
              <span class="contact-disc" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2" />
                  <path d="m2 7 10 6 10-6" />
                </svg>
              </span>
              <span class="contact-way__text">
                <span class="contact-way__label">{t.contact.info.emailLabel}</span>
                <span class="contact-way__value">{contact.email}</span>
              </span>
              <span aria-hidden="true" class="contact-way__go"><Arrow dir="right" /></span>
            </a>
          </li>

          {/* The landline is a desk telephone, the mobile a handset
              (2026-11-03, asked for; `ui/PhoneIcon.astro`, same in the footer). */}
          <li>
            <a class="contact-way" href={`tel:${landlineHref}`}>
              <span class="contact-disc" aria-hidden="true">
                <PhoneIcon kind="landline" />
              </span>
              <span class="contact-way__text">
                <span class="contact-way__label">{ui.landlineLabel}</span>
                <span class="contact-way__value">{siteConfig.telephone}</span>
              </span>
              <span aria-hidden="true" class="contact-way__go"><Arrow dir="right" /></span>
            </a>
          </li>

          <li>
            <a class="contact-way" href={`tel:${phoneHref}`}>
              <span class="contact-disc" aria-hidden="true">
                <PhoneIcon kind="mobile" />
              </span>
              <span class="contact-way__text">
                <span class="contact-way__label">{t.contact.info.phoneLabel}</span>
                {/* "Auch für Notfälle" beside the number itself (2026-10-12):
                    the one place a visitor in a hurry looks. */}
                <span class="contact-way__value-row">
                  <span class="contact-way__value">{phoneDisplay}</span>
                  <span class="contact-way__badge">{ui.urgentBadge}</span>
                </span>
              </span>
              <span aria-hidden="true" class="contact-way__go"><Arrow dir="right" /></span>
            </a>
          </li>
        </ul>

        <div class="contact-card__group contact-card__social">
          <p class="contact-way__label contact-card__group-label">{ui.channelsLabel}</p>
          <div class="contact-card__social-row">
            {/* `target`/`rel` because it leaves for a messenger, like every
                link in `SocialLinks`. Icon only (2026-10-19, asked for), like
                the footer's profiles; the name is the accessible label. */}
            <a
              class="contact-action contact-action--whatsapp"
              href={whatsappHref(contact.phone)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={WHATSAPP_ICON} />
              </svg>
            </a>
          </div>
        </div>
      </aside>

      {/* The card's last row (2026-11-03): where the business sits and what to
          take away, across both halves. The map is the drawn one with the live
          OpenStreetMap over it from the first hover, focus or tap
          (`ui/PlaceBubble.astro`, `inline`). The full address stays where the
          law and the search engines need it: the Impressum and the JSON-LD.

          The business card page and the .vcf do different jobs: the file lands
          in a phone's address book (text/vcard in `public/.htaccess`), the
          page is what a person can be shown, scan or forward.
          TODO: promote the .vcf to tds-shared contact.vcard */}
      <div class="contact-foot">
        <div class="contact-foot__map">
          <PlaceBubble lang={lang} id="contact-place-map" inline />
        </div>
        <div class="contact-foot__place">
          <p class="contact-way__label">{t.contact.info.locationLabel}</p>
          <p class="contact-foot__town">
            {siteConfig.address.addressLocality}
          </p>
          <p class="contact-foot__region">{ui.region}</p>
        </div>
        <div class="contact-foot__actions">
          <a class="contact-action" href={businessCardHref(lang)}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <circle cx="8" cy="12" r="2.5" />
              <path d="M14 10h5M14 14h3" />
            </svg>
            {ui.businessCard}
          </a>
          <a class="contact-action" href="/kontakt.vcf">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <line x1="19" y1="8" x2="19" y2="14" />
              <line x1="22" y1="11" x2="16" y2="11" />
            </svg>
            {ui.saveContact}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { handOffContactDraft } from "~/lib/contactDraft";
  import { QUOTE_PARAM, readQuoteRequest } from "~/lib/quoteRequest";

  const quote = readQuoteRequest(window.location.search);
  if (quote) {
    handOffContactDraft({ message: quote, service: "web-presence" });
    // A reload must not write over what the visitor has changed since.
    const url = new URL(window.location.href);
    url.searchParams.delete(QUOTE_PARAM);
    window.history.replaceState(null, "", url);
  }
</script>
